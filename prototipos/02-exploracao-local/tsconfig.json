{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "allowJs": true,
    "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "server", "vite.config.ts"]
}
